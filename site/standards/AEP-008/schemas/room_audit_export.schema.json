    "docket_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "packet_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "selection_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "permission_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rollback_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "public_report_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "audit_export_id": {
      "type": "string"
    },
    "room_id": {
      "type": "string"
    },
    "manifest_ref": {
      "type": "string"
    },
    "charter_ref": {
      "type": "string"
    },
    "evidence_boundary_ref": {
      "type": "string"
    },
    "role_registry_ref": {
      "type": "string"
    },
    "decision_log_ref": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "hash": {
