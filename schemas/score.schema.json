{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proof Gradient Score",
  "type": "object",
  "required": [
    "proof_id",
    "passed",
    "quality_score",
    "safety_score",
    "credit_assignment"
  ],
  "properties": {
    "proof_id": {
      "type": "string"
    },
    "passed": {
      "type": "boolean"
    },
    "quality_score": {
      "type": "number"
    },
    "safety_score": {
      "type": "number"
    },
    "credit_assignment": {
      "type": "object"
    }
  }
}
